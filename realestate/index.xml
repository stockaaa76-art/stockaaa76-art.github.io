<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>不動産投資 on Turnip Lab</title><link>https://stockaaa76-art.github.io/realestate/</link><description>Recent content in 不動産投資 on Turnip Lab</description><generator>Hugo</generator><language>ja</language><atom:link href="https://stockaaa76-art.github.io/realestate/index.xml" rel="self" type="application/rss+xml"/><item><title>不動産投資シミュレーター</title><link>https://stockaaa76-art.github.io/realestate/simulator/</link><pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate><guid>https://stockaaa76-art.github.io/realestate/simulator/</guid><description>&lt;div class="re-tool"&gt;&#10;&lt;div class="re-section-label"&gt;物件情報&lt;/div&gt;&#10;&lt;div class="re-grid"&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;物件価格（万円）&lt;/label&gt;&#10; &lt;input type="number" id="price" value="3000" min="1" step="100"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;購入諸費用（万円）&lt;/label&gt;&#10; &lt;input type="number" id="cost" value="180" min="0" step="10"&gt;&#10; &lt;span class="re-hint"&gt;物件価格の5〜8%が目安&lt;/span&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;月額賃料想定（万円）&lt;/label&gt;&#10; &lt;input type="number" id="rent" value="12" min="0" step="0.5"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;空室率想定（%）&lt;/label&gt;&#10; &lt;input type="number" id="vacancy" value="5" min="0" max="100" step="1"&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="re-section-label"&gt;運営コスト（月額）&lt;/div&gt;&#10;&lt;div class="re-grid"&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;管理費・管理委託料（万円）&lt;/label&gt;&#10; &lt;input type="number" id="mgmt" value="0.6" min="0" step="0.1"&gt;&#10; &lt;span class="re-hint"&gt;賃料の5%が目安&lt;/span&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;修繕積立・その他（万円）&lt;/label&gt;&#10; &lt;input type="number" id="repair" value="0.5" min="0" step="0.1"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;年間固定費（固定資産税等・万円）&lt;/label&gt;&#10; &lt;input type="number" id="fixedcost" value="10" min="0" step="1"&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="re-section-label"&gt;ローン条件&lt;/div&gt;&#10;&lt;div class="re-grid"&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;頭金（万円）&lt;/label&gt;&#10; &lt;input type="number" id="downpayment" value="600" min="0" step="100"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;金利（年利 %）&lt;/label&gt;&#10; &lt;input type="number" id="rate" value="2.0" min="0" max="20" step="0.1"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-row"&gt;&#10; &lt;label&gt;返済期間（年）&lt;/label&gt;&#10; &lt;input type="number" id="loanterm" value="35" min="1" max="50" step="1"&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;p&gt;&lt;button class="re-btn" onclick="calcRE()"&gt;計算する&lt;/button&gt;&lt;/p&gt;&#10;&lt;div id="re-result" style="display:none;"&gt;&#10;&lt;div class="re-section-label" style="margin-top:28px;"&gt;利回り&lt;/div&gt;&#10;&lt;div class="re-kpi-grid"&gt;&#10; &lt;div class="re-kpi highlight"&gt;&#10; &lt;div class="re-kpi-label"&gt;表面利回り&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="gross-yield"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-kpi highlight2"&gt;&#10; &lt;div class="re-kpi-label"&gt;実質利回り&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="net-yield"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;自己資金利回り（CCR）&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="ccr"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="re-section-label" style="margin-top:20px;"&gt;キャッシュフロー&lt;/div&gt;&#10;&lt;div class="re-kpi-grid"&gt;&#10; &lt;div class="re-kpi" id="cf-card"&gt;&#10; &lt;div class="re-kpi-label"&gt;月次CF&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="monthly-cf"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;年次CF&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="annual-cf"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;月額ローン返済&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="monthly-loan"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="re-section-label" style="margin-top:20px;"&gt;ローン詳細&lt;/div&gt;&#10;&lt;div class="re-kpi-grid"&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;借入金額&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="loan-amount"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;総返済額&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="total-repay"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;総利息&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="total-interest"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="re-section-label" style="margin-top:20px;"&gt;損益分岐&lt;/div&gt;&#10;&lt;div class="re-kpi-grid"&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;CF黒字化に必要な最低賃料&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="breakeven-rent"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="re-kpi"&gt;&#10; &lt;div class="re-kpi-label"&gt;現在賃料との差&lt;/div&gt;&#10; &lt;div class="re-kpi-value" id="rent-margin"&gt;&lt;/div&gt;&#10; &lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;div class="re-verdict" id="verdict"&gt;&lt;/div&gt;&#10;&lt;/div&gt;&#10;&lt;/div&gt;</description></item></channel></rss>